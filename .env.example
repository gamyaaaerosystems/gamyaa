# Copy to .env.local for local overrides. Never commit real secrets.

# Canonical host for Gamyaa AeroSystems:
#   path      → https://gamyaa.in/aerosystems is canonical (default)
#   subdomain → https://aerosystems.gamyaa.in is canonical (requires the DNS/domain to be live)
NEXT_PUBLIC_AEROSYSTEMS_CANONICAL=path

# Google Analytics 4 (G-VRS5BMWG9R) loads in production builds only.
# Set to 1 to disable it (e.g. staging/preview deployments).
NEXT_PUBLIC_GA_DISABLED=
# Set to 1 to add debug_mode to custom events for GA4 DebugView.
NEXT_PUBLIC_GA_DEBUG=

# Contact form delivery via Resend (https://resend.com). The online form is shown
# only when both RESEND_API_KEY and CONTACT_FROM_EMAIL are set at build time;
# otherwise the contact pages offer Email Us / Call Us. Redeploy after setting them.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Gamyaa Website <website@gamyaa.in>"
CONTACT_TO_EMAIL=gamyaa.aerosystems@gmail.com

# Optional: shared rate limiting for /api/contact across server instances
# (Upstash Redis REST API). Without these, a per-instance in-memory limit applies.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Google Search Console HTML-tag verification token (DNS verification also works).
GOOGLE_SITE_VERIFICATION=

# Testing only: show the contact form even without email delivery configured.
CONTACT_FORM_FORCE=
